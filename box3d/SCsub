#!/usr/bin/env python

import glob

Import("env")
Import("env_modules")

env_box3d = env_modules.Clone()

# Thirdparty source files

thirdparty_dir = Dir(".").abspath + "/thirdparty/box3d"

# Box3D's own CMakeLists lists every src/*.c explicitly; globbing keeps this in sync
# with the pinned submodule without a file list to maintain.
thirdparty_sources = sorted(glob.glob(thirdparty_dir + "/src/*.c"))

env_box3d.Prepend(CPPPATH=[thirdparty_dir + "/include"])

env_thirdparty = env_box3d.Clone()
env_thirdparty.disable_warnings()
# Box3D needs C17 (_Static_assert, anonymous unions) and requires floating point
# contraction off for cross-platform determinism. -ffast-math is not supported.
if env.msvc:
    env_thirdparty.Append(CFLAGS=["/std:c17"])
else:
    env_thirdparty.Append(CFLAGS=["-std=gnu17"])
    env_thirdparty.Append(CCFLAGS=["-ffp-contract=off"])
env_thirdparty.Prepend(CPPPATH=[thirdparty_dir + "/src"])

thirdparty_obj = []
env_thirdparty.add_source_files(thirdparty_obj, thirdparty_sources)
env.modules_sources += thirdparty_obj


# Godot source files

module_obj = []

env_box3d.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj

# Needed to force rebuilding the module files when the thirdparty library is updated.
env.Depends(module_obj, thirdparty_obj)
