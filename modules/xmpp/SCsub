    "silk/fixed/schur_FIX.c",
]

env_opus = env_xmpp.Clone()
env_opus.disable_warnings()
env_opus.Append(CPPDEFINES=["HAVE_CONFIG_H"])
if env["platform"] in ["android", "iphone", "javascript"]:
    env_opus.Append(CPPDEFINES=["FIXED_POINT"])
    opus_sources += opus_silk_fixed
else:
    opus_sources += opus_silk_float
if env["platform"] == "android" and "android_arch" in env:
    if env["android_arch"] == "arm64v8":
        env_opus.Append(CPPDEFINES=["OPUS_ARM64_OPT"])
    elif env["android_arch"] == "armv7":
        env_opus.Append(CPPDEFINES=["OPUS_ARM_OPT"])
opus_obj = []
env_opus.add_source_files(opus_obj, [opus_dir + f for f in opus_sources])

env_ogg = env_xmpp.Clone()
env_ogg.disable_warnings()
ogg_obj = []
env_ogg.add_source_files(ogg_obj, [ogg_dir + "bitwise.c", ogg_dir + "framing.c"])

# ---------------------------------------------------------------------------
# Código del módulo. El OMEMO usa mbedTLS (AES-CBC/HMAC/HKDF) con el mismo
# config header que modules/mbedtls.
# ---------------------------------------------------------------------------
env_xmpp.Prepend(CPPPATH=["#thirdparty/mbedtls/include"])
env_xmpp.Append(CPPDEFINES=[("MBEDTLS_CONFIG_FILE", config_path)])
module_obj = []
env_xmpp.add_source_files(module_obj, "*.cpp")

env.modules_sources += thirdparty_obj
env.modules_sources += tls_obj
env.modules_sources += opus_obj
env.modules_sources += ogg_obj
env.modules_sources += module_obj
