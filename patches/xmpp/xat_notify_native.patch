+/**************************************************************************/
+/*  xat_notify_ios.h                                                      */
+/*                                                                        */
+/*  Contraparte iOS del plugin nativo XatNotify (ver XatNotify.java en     */
+/*  Android): notificaciones locales (UNUserNotificationCenter) y token    */
+/*  push APNs (hex). Se registra como singleton Godot "XatNotify" con la  */
+/*  MISMA interfaz GDScript que la versión Android, para que app/ sea     */
+/*  multiplataforma.                                                      */
+/**************************************************************************/
+
+#ifndef XAT_NOTIFY_IOS_H
+#define XAT_NOTIFY_IOS_H
+
+#include "core/object.h"
+#include "core/ustring.h"
+
+class XatNotifyIOS : public Object {
+	GDCLASS(XatNotifyIOS, Object);
+
+	static void _bind_methods();
+
+public:
+	bool is_available();
+	bool request_permission();
+	String get_device_token();
+	void notify(const String &p_title, const String &p_body, const String &p_jid, const String &p_tag);
+	void clear(const String &p_jid);
+
+	XatNotifyIOS();
+	~XatNotifyIOS();
+};
+
+// Token APNs capturado por el delegate (godot_app_delegate.m) vía
+// application:didRegisterForRemoteNotificationsWithDeviceToken:. Enlazado C
+// para poder llamarlo desde Objective-C (.m). Declarado también como extern en
+// godot_app_delegate.m.
+#ifdef __cplusplus
+extern "C" {
+#endif
+void xat_notify_set_apns_token(const char *p_hex);
+#ifdef __cplusplus
+}
+#endif
+
+#endif // XAT_NOTIFY_IOS_H
diff --git a/platform/iphone/xat_notify_ios.mm b/platform/iphone/xat_notify_ios.mm
new file mode 100644
index 0000000000..a101a7b153
--- /dev/null
+++ b/platform/iphone/xat_notify_ios.mm
@@ -0,0 +1,154 @@
+/**************************************************************************/
+/*  xat_notify_ios.mm                                                     */
+/*                                                                        */
+/*  Implementación iOS del singleton XatNotify: notificaciones locales    */
+/*  inmediatas con UNUserNotificationCenter y token push APNs en hex. El  */
+/*  token lo captura el delegate (godot_app_delegate.m) y lo entrega por  */
+/*  xat_notify_set_apns_token(); get_device_token() lo devuelve.          */
+/**************************************************************************/
+
+#include "xat_notify_ios.h"
+
+#include "core/class_db.h"
+#include "core/method_bind.h"
+
+#import <UIKit/UIKit.h>
+#import <UserNotifications/UserNotifications.h>
+
+// El delegate es GodotApplicalitionDelegate (godot_app_delegate.m), el
+// UIApplicationDelegate real de main.m; ahí viven los callbacks APNs.
+
+// Token APNs en hex. static: vive mientras dura el proceso; get_device_token()
+// lo devuelve. Se rellena desde el delegate en el hilo principal.
+static String xat_apns_token_hex;
+
+// Último estado de autorización conocido. La petición de permiso en iOS es
+// asíncrona (diálogo del sistema): no se puede bloquear el hilo principal para
+// devolver el resultado, así que request_permission() devuelve este cache
+// (optimista) y el completion lo actualiza. El cliente ignora el valor.
+static bool xat_notifications_authorized = true;
+
+// Enlazado C: lo llama godot_app_delegate.m desde
+// application:didRegisterForRemoteNotificationsWithDeviceToken:.
+extern "C" void xat_notify_set_apns_token(const char *p_hex) {
+	xat_apns_token_hex = String::utf8(p_hex != nullptr ? p_hex : "");
+}
+
+static NSString *xat_nsstring(const String &p_str) {
+	const CharString utf8 = p_str.utf8();
+	NSString *result = [NSString stringWithUTF8String:utf8.get_data()];
+	return result != nil ? result : @"";
+}
+
+void XatNotifyIOS::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("isAvailable"), &XatNotifyIOS::is_available);
+	ClassDB::bind_method(D_METHOD("requestPermission"), &XatNotifyIOS::request_permission);
+	ClassDB::bind_method(D_METHOD("getDeviceToken"), &XatNotifyIOS::get_device_token);
+	ClassDB::bind_method(D_METHOD("notify", "title", "body", "jid", "tag"), &XatNotifyIOS::notify);
+	ClassDB::bind_method(D_METHOD("clear", "jid"), &XatNotifyIOS::clear);
+
+	// Alias snake_case: ui/notifier.gd invoca request_permission() y
+	// get_device_token() (convención del resto de la API nativa de Godot).
+	// Mismo comportamiento que los camelCase del contrato primario.
+	ClassDB::bind_method(D_METHOD("request_permission"), &XatNotifyIOS::request_permission);
+	ClassDB::bind_method(D_METHOD("get_device_token"), &XatNotifyIOS::get_device_token);
+}
+
+bool XatNotifyIOS::is_available() {
+	return true;
+}
+
+bool XatNotifyIOS::request_permission() {
+	// Pide permiso (alertas + sonido + badge) y, al concederse, dispara el
+	// registro APNs en el hilo principal. El completion llega en una cola
+	// arbitraria; no se bloquea aquí (el diálogo del sistema necesita el run
+	// loop principal). Devuelve el último estado conocido (optimista).
+	UNUserNotificationCenter *center = [UNUserNotificationCenter currentNotificationCenter];
+	[center requestAuthorizationWithOptions:(UNAuthorizationOptionAlert | UNAuthorizationOptionSound | UNAuthorizationOptionBadge)
+					  completionHandler:^(BOOL p_granted, NSError *p_error) {
+						  xat_notifications_authorized = p_granted;
+						  dispatch_async(dispatch_get_main_queue(), ^{
+							  [[UIApplication sharedApplication] registerForRemoteNotifications];
+						  });
+					  }];
+	// Si ya estaba autorizado de antes, el completion no cambia nada: registrar
+	// también de inmediato para obtener el token sin esperar al diálogo.
+	dispatch_async(dispatch_get_main_queue(), ^{
+		[[UIApplication sharedApplication] registerForRemoteNotifications];
+	});
+	return xat_notifications_authorized;
+}
+
+String XatNotifyIOS::get_device_token() {
+	return xat_apns_token_hex;
+}
+
+void XatNotifyIOS::notify(const String &p_title, const String &p_body, const String &p_jid, const String &p_tag) {
+	NSString *title = xat_nsstring(p_title);
+	NSString *body = xat_nsstring(p_body);
+	NSString *jid = xat_nsstring(p_jid);
+	NSString *tag = xat_nsstring(p_tag);
+
+	UNMutableNotificationContent *content = [[UNMutableNotificationContent alloc] init];
+	content.title = title;
+	content.body = body;
+	content.sound = [UNNotificationSound defaultSound];
+
+	NSMutableDictionary *info = [NSMutableDictionary dictionary];
+	if (jid.length > 0) {
+		info[@"xat_jid"] = jid;
+		// Agrupa por conversación; clear() lo usa para filtrar.
+		content.threadIdentifier = jid;
+	}
+	if (tag.length > 0) {
+		info[@"xat_tag"] = tag;
+	}
+	content.userInfo = info;
+
+	// Una notificación por mensaje (identifier = tag); sin tag, por conversación.
+	NSString *identifier = tag.length > 0 ? tag : (jid.length > 0 ? jid : [[NSUUID UUID] UUIDString]);
+	// Disparo inmediato (el mínimo práctico de time-interval es 0).
+	UNTimeIntervalNotificationTrigger *trigger = [UNTimeIntervalNotificationTrigger triggerWithTimeInterval:0.1 repeats:NO];
+	UNNotificationRequest *request = [UNNotificationRequest requestWithIdentifier:identifier content:content trigger:trigger];
+	[[UNUserNotificationCenter currentNotificationCenter] addNotificationRequest:request withCompletionHandler:nil];
+}
+
+void XatNotifyIOS::clear(const String &p_jid) {
+	NSString *jid = xat_nsstring(p_jid);
+	if (jid.length == 0) {
+		return;
+	}
+	UNUserNotificationCenter *center = [UNUserNotificationCenter currentNotificationCenter];
+
+	// Como el identifier es el tag del mensaje, se retira por conversación
+	// filtrando por threadIdentifier/userInfo (ambos llevan el jid).
+	[center getPendingNotificationRequestsWithCompletionHandler:^(NSArray<UNNotificationRequest *> *requests) {
+		NSMutableArray<NSString *> *ids = [NSMutableArray array];
+		for (UNNotificationRequest *request in requests) {
+			if ([request.content.threadIdentifier isEqualToString:jid] ||
+					[request.content.userInfo[@"xat_jid"] isEqualToString:jid]) {
+				[ids addObject:request.identifier];
+			}
+		}
+		if (ids.count > 0) {
+			[center removePendingNotificationRequestsWithIdentifiers:ids];
+		}
+	}];
+
+	[center getDeliveredNotificationsWithCompletionHandler:^(NSArray<UNNotification *> *notifications) {
+		NSMutableArray<NSString *> *ids = [NSMutableArray array];
+		for (UNNotification *notification in notifications) {
+			if ([notification.request.content.threadIdentifier isEqualToString:jid] ||
+					[notification.request.content.userInfo[@"xat_jid"] isEqualToString:jid]) {
+				[ids addObject:notification.request.identifier];
+			}
+		}
+		if (ids.count > 0) {
+			[center removeDeliveredNotificationsWithIdentifiers:ids];
+		}
+	}];
+}
+
+XatNotifyIOS::XatNotifyIOS() {}
+
+XatNotifyIOS::~XatNotifyIOS() {}
