--- /dev/null
+++ b/platform/android/java/lib/src/org/godotengine/godot/XatMessagingService.java
@@ -0,0 +1,41 @@
+/**************************************************************************/
+/*  XatMessagingService.java                                             */
+/*                                                                        */
+/*  Servicio FCM que entrega el token (onNewToken) a XatNotify y postea   */
+/*  la notificación local cuando llega un mensaje en primer plano.        */
+/*  La plantilla Android incluye firebase-messaging (build.gradle) y la    */
+/*  app inicializa Firebase por código (XatNotify.configure).             */
+/**************************************************************************/
+
+package org.godotengine.godot;
+
+import androidx.annotation.NonNull;
+
+import com.google.firebase.messaging.FirebaseMessagingService;
+import com.google.firebase.messaging.RemoteMessage;
+
+import java.util.Map;
+
+public class XatMessagingService extends FirebaseMessagingService {
+	@Override
+	public void onNewToken(@NonNull String token) {
+		super.onNewToken(token);
+		// Persiste el token para que XatNotify.getDeviceToken() lo devuelva.
+		XatNotify.setFcmToken(token);
+	}
+
+	@Override
+	public void onMessageReceived(@NonNull RemoteMessage message) {
+		super.onMessageReceived(message);
+		Map<String, String> data = message.getData();
+		if (data.isEmpty()) {
+			return;
+		}
+		String title = data.containsKey("title") ? data.get("title") : "xat";
+		String body = data.containsKey("body") ? data.get("body") : "";
+		String jid = data.containsKey("jid") ? data.get("jid") : "";
+		String tag = data.containsKey("tag") ? data.get("tag") : "";
+		// Con el proceso vivo, XatNotify ya está cargado y postea el aviso local.
+		XatNotify.postLocal(getApplicationContext(), title, body, jid, tag);
+	}
+}
diff --git a/platform/android/java/lib/src/org/godotengine/godot/XatNotify.java b/platform/android/java/lib/src/org/godotengine/godot/XatNotify.java
new file mode 100644
index 0000000000..ef3be3e420
--- /dev/null
+++ b/platform/android/java/lib/src/org/godotengine/godot/XatNotify.java
@@ -0,0 +1,397 @@
+/**************************************************************************/
+/*  XatNotify.java                                                        */
+/*                                                                        */
+/*  Plugin Android integrado del fork xat: notificaciones locales del     */
+/*  sistema y puente al push FCM (XEP-0357). Godot 3 no trae API de       */
+/*  notificaciones ni de mensajería, así que viven en la capa Java del    */
+/*  motor y se registran como singleton Godot ("XatNotify").             */
+/*                                                                        */
+/*  FCM: la plantilla incluye firebase-messaging (lib/build.gradle). La app   */
+/*  configura Firebase con los valores de su google-services.json via        */
+/*  configure(apiKey, appId, projectId, senderId); así no se requiere el      */
+/*  plugin Gradle `google-services` ni hornear la config en la plantilla.     */
+/**************************************************************************/
+
+package org.godotengine.godot;
+
+import android.Manifest;
+import android.app.Activity;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.media.AudioAttributes;
+import android.net.Uri;
+import android.os.Build;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.core.app.ActivityCompat;
+import androidx.core.app.NotificationCompat;
+import androidx.core.app.NotificationManagerCompat;
+import androidx.core.content.ContextCompat;
+
+import com.google.android.gms.tasks.Task;
+import com.google.android.gms.tasks.Tasks;
+import com.google.firebase.FirebaseApp;
+import com.google.firebase.FirebaseOptions;
+import com.google.firebase.messaging.FirebaseMessaging;
+
+import org.godotengine.godot.plugin.GodotPlugin;
+import org.godotengine.godot.plugin.UsedByGodot;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Notificaciones locales y token push para xat.
+ *
+ * <p>La interfaz GDScript es:</p>
+ * <ul>
+ *   <li>{@code isAvailable() -> bool}: true si el plugin está cargado.</li>
+ *   <li>{@code requestPermission() -> bool}: pide POST_NOTIFICATIONS (Android
+ *       13+) y devuelve si ya estaba concedido.</li>
+ *   <li>{@code getDeviceToken() -> String}: token FCM, o "" si Firebase no
+ *       está inicializado todavía (es asíncrono, se rellena después).</li>
+ *   <li>{@code notify(title, body, jid, tag)}: publica un aviso local.</li>
+ *   <li>{@code clear(jid)}: retira los avisos locales de esa conversación.</li>
+ * </ul>
+ *
+ * <p>Godot 3 expone los métodos Java con su nombre exacto (ver
+ * {@code godot_plugin_jni.cpp}); el resto de la API nativa del fork usa
+ * camelCase, así que además de los cinco métodos del contrato se ofrecen
+ * alias snake_case ({@code request_permission}, {@code get_device_token})
+ * porque {@code addon/xat_xmpp/ui/notifier.gd} los invoca así.</p>
+ */
+public class XatNotify extends GodotPlugin {
+	public static final String PLUGIN_NAME = "XatNotify";
+
+	private static final String TAG = "XatNotify";
+	private static final String CHANNEL_ID = "xmpp_messages";
+	private static final String PREFS = "xat_notify";
+	private static final String PREF_FCM_TOKEN = "fcm_token";
+	private static final int REQUEST_NOTIFICATIONS = 0x58415410;
+
+	// Token FCM compartido con XatMessagingService (subclase de
+	// FirebaseMessagingService). Se cachea en memoria y en SharedPreferences
+	// para sobrevivir reinicios y obtenerlo sin bloquear el hilo principal.
+	private static volatile String sToken = null;
+	private static volatile Context sAppContext = null;
+
+	// Opciones de Firebase provistas por la app (de google-services.json). Se
+	// inicializa Firebase manualmente para no requerir el plugin Gradle
+	// `google-services` ni hornear la config de xat en la plantilla pública.
+	private static volatile boolean sFirebaseReady = false;
+	private static String sApiKey = "";
+	private static String sAppId = "";
+	private static String sProjectId = "";
+	private static String sSenderId = "";
+
+	// jid -> identificadores (tag) de los avisos locales vivos de esa
+	// conversación, para que clear(jid) pueda retirarlos.
+	private static final Map<String, List<String>> conversationTags = new HashMap<>();
+
+	public XatNotify(Godot godot) {
+		super(godot);
+		Activity activity = getActivity();
+		if (activity != null) {
+			sAppContext = activity.getApplicationContext();
+		}
+		loadPersistedToken();
+	}
+
+	@NonNull
+	@Override
+	public String getPluginName() {
+		return PLUGIN_NAME;
+	}
+
+	@UsedByGodot
+	public boolean isAvailable() {
+		return true;
+	}
+
+	/**
+	 * Pide el permiso de notificaciones. En Android 13 (API 33) es
+	 * POST_NOTIFICATIONS; antes no hace falta y se considera concedido.
+	 * Devuelve true si el permiso ya estaba concedido.
+	 */
+	@UsedByGodot
+	public boolean requestPermission() {
+		final Activity activity = getActivity();
+		if (activity == null) {
+			return false;
+		}
+		if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+			return true;
+		}
+		boolean granted = ContextCompat.checkSelfPermission(activity, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED;
+		if (!granted) {
+			ActivityCompat.requestPermissions(activity, new String[] { Manifest.permission.POST_NOTIFICATIONS }, REQUEST_NOTIFICATIONS);
+		}
+		return granted;
+	}
+
+	/**
+	 * Configura Firebase con los valores de {@code google-services.json} de la
+	 * app (project_info + client). La app debe llamarlo antes de
+	 * {@link #getDeviceToken()} (main.gd lo hace al conectar).
+	 */
+	@UsedByGodot
+	public void configure(String apiKey, String appId, String projectId, String senderId) {
+		sApiKey = apiKey != null ? apiKey : "";
+		sAppId = appId != null ? appId : "";
+		sProjectId = projectId != null ? projectId : "";
+		sSenderId = senderId != null ? senderId : "";
+		ensureFirebaseApp();
+	}
+
+	/** Alias snake_case (convención del resto de la API nativa de Godot). */
+	@UsedByGodot
+	public void configure_firebase(String apiKey, String appId, String projectId, String senderId) {
+		configure(apiKey, appId, projectId, senderId);
+	}
+
+	/**
+	 * Token FCM del dispositivo para XEP-0357. Devuelve "" si Firebase no está
+	 * configurado o el token aún no está listo (la consulta es asíncrona); la
+	 * app re-registra al reconectar.
+	 */
+	@UsedByGodot
+	public String getDeviceToken() {
+		if (sToken == null) {
+			loadPersistedToken();
+		}
+		if (sToken == null) {
+			ensureFirebaseApp();
+			fetchFcmTokenAsync();
+		}
+		return sToken == null ? "" : sToken;
+	}
+
+	/** Inicializa FirebaseApp una sola vez, con las opciones de la app. */
+	private static void ensureFirebaseApp() {
+		if (sFirebaseReady || sAppContext == null || sAppId.isEmpty()) {
+			return;
+		}
+		try {
+			if (FirebaseApp.getApps(sAppContext).isEmpty()) {
+				FirebaseOptions options = new FirebaseOptions.Builder()
+						.setApiKey(sApiKey)
+						.setApplicationId(sAppId)
+						.setProjectId(sProjectId)
+						.setGcmSenderId(sSenderId)
+						.build();
+				FirebaseApp.initializeApp(sAppContext, options);
+			}
+			sFirebaseReady = true;
+		} catch (Throwable t) {
+			Log.w(TAG, "No se pudo inicializar Firebase: " + t.getMessage());
+		}
+	}
+
+	/**
+	 * Publica una notificación local. {@code jid} es la conversación (se guarda
+	 * como extra "xat_jid" del launch intent) y {@code tag} el id del mensaje.
+	 */
+	@UsedByGodot
+	public void notify(String title, String body, String jid, String tag) {
+		final Activity activity = getActivity();
+		if (activity == null) {
+			return;
+		}
+		postLocal(activity, title, body, jid, tag);
+	}
+
+	/** Retira los avisos locales de la conversación {@code jid}. */
+	@UsedByGodot
+	public void clear(String jid) {
+		final Activity activity = getActivity();
+		if (activity == null) {
+			return;
+		}
+		clearLocal(activity, jid);
+	}
+
+	// --- Alias snake_case --------------------------------------------------
+	// ui/notifier.gd llama a estos dos métodos con la convención snake_case del
+	// resto de la API nativa de Godot; el contrato camelCase es el primario y
+	// ambos apuntan al mismo comportamiento.
+
+	@UsedByGodot
+	public boolean request_permission() {
+		return requestPermission();
+	}
+
+	@UsedByGodot
+	public String get_device_token() {
+		return getDeviceToken();
+	}
+
+	// --- Implementación compartida (static: la usa XatMessagingService) ----
+
+	/** Publica el aviso; accesible desde XatMessagingService. */
+	public static void postLocal(Context context, String title, String body, String jid, String tag) {
+		if (context == null) {
+			return;
+		}
+		ensureChannel(context);
+
+		String safeJid = jid != null ? jid : "";
+		String safeTag = (tag != null && !tag.isEmpty()) ? tag : safeJid;
+		if (safeTag.isEmpty()) {
+			safeTag = "xat-" + System.currentTimeMillis();
+		}
+		int id = safeTag.hashCode();
+
+		Intent launch = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName());
+		if (launch == null) {
+			return;
+		}
+		launch.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP);
+		if (!safeJid.isEmpty()) {
+			launch.putExtra("xat_jid", safeJid);
+		}
+
+		int pendingFlags = PendingIntent.FLAG_UPDATE_CURRENT;
+		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+			pendingFlags |= PendingIntent.FLAG_IMMUTABLE;
+		}
+		PendingIntent contentIntent = PendingIntent.getActivity(context, id, launch, pendingFlags);
+
+		int icon = context.getApplicationInfo().icon;
+		if (icon == 0) {
+			icon = android.R.drawable.ic_dialog_info;
+		}
+
+		NotificationCompat.Builder builder = new NotificationCompat.Builder(context, CHANNEL_ID)
+				.setSmallIcon(icon)
+				.setContentTitle(title != null ? title : "")
+				.setContentText(body != null ? body : "")
+				.setAutoCancel(true)
+				.setPriority(NotificationCompat.PRIORITY_HIGH)
+				.setCategory(NotificationCompat.CATEGORY_MESSAGE)
+				.setContentIntent(contentIntent);
+
+		try {
+			NotificationManagerCompat.from(context).notify(safeTag, id, builder.build());
+		} catch (SecurityException e) {
+			// Sin POST_NOTIFICATIONS: se ignora, no es un error de la app.
+			Log.w(TAG, "Falta el permiso de notificaciones", e);
+			return;
+		}
+		trackTag(safeJid, safeTag);
+	}
+
+	/** Retira pendientes/entregadas de la conversación; accesible desde el service. */
+	public static void clearLocal(Context context, String jid) {
+		if (context == null) {
+			return;
+		}
+		String key = jid != null ? jid : "";
+		NotificationManagerCompat manager = NotificationManagerCompat.from(context);
+		List<String> tags;
+		synchronized (conversationTags) {
+			tags = conversationTags.remove(key);
+		}
+		if (tags != null) {
+			for (String t : tags) {
+				manager.cancel(t, t.hashCode());
+			}
+		}
+		// Avisos sin tag explícito se registraron con tag = jid.
+		if (!key.isEmpty()) {
+			manager.cancel(key, key.hashCode());
+		}
+	}
+
+	private static void trackTag(String jid, String tag) {
+		synchronized (conversationTags) {
+			List<String> tags = conversationTags.get(jid);
+			if (tags == null) {
+				tags = new ArrayList<>();
+				conversationTags.put(jid, tags);
+			}
+			if (!tags.contains(tag)) {
+				tags.add(tag);
+			}
+		}
+	}
+
+	private static void ensureChannel(Context context) {
+		if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+			return;
+		}
+		NotificationManager manager = (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
+		if (manager == null || manager.getNotificationChannel(CHANNEL_ID) != null) {
+			return;
+		}
+		NotificationChannel channel = new NotificationChannel(CHANNEL_ID, "Mensajes", NotificationManager.IMPORTANCE_HIGH);
+		channel.setDescription("Mensajes de xat");
+		channel.enableLights(true);
+		channel.enableVibration(true);
+		AudioAttributes attrs = new AudioAttributes.Builder()
+				.setUsage(AudioAttributes.USAGE_NOTIFICATION)
+				.build();
+		Uri sound = Settings.System.DEFAULT_NOTIFICATION_URI;
+		channel.setSound(sound, attrs);
+		manager.createNotificationChannel(channel);
+	}
+
+	/** Guarda el token que entrega FCM (lo llama XatMessagingService.onNewToken). */
+	public static void setFcmToken(String token) {
+		if (token == null || token.isEmpty()) {
+			return;
+		}
+		sToken = token;
+		Context context = sAppContext;
+		if (context != null) {
+			context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+					.edit()
+					.putString(PREF_FCM_TOKEN, token)
+					.apply();
+		}
+	}
+
+	private static void loadPersistedToken() {
+		if (sToken != null || sAppContext == null) {
+			return;
+		}
+		SharedPreferences prefs = sAppContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+		String token = prefs.getString(PREF_FCM_TOKEN, null);
+		if (token != null && !token.isEmpty()) {
+			sToken = token;
+		}
+	}
+
+	/**
+	 * Obtiene el token FCM en un hilo de trabajo (FCM exige no bloquear el
+	 * hilo principal). Requiere que FirebaseApp esté inicializado.
+	 */
+	private static void fetchFcmTokenAsync() {
+		if (!sFirebaseReady) {
+			return;
+		}
+		new Thread(new Runnable() {
+			@Override
+			public void run() {
+				try {
+					Task<String> task = FirebaseMessaging.getInstance().getToken();
+					String token = Tasks.await(task);
+					if (token != null && !token.isEmpty()) {
+						setFcmToken(token);
+					}
+				} catch (Throwable t) {
+					// FCM no disponible (sin Google Play services, sin red…).
+					Log.i(TAG, "FCM no disponible: " + t.getClass().getSimpleName());
+				}
+			}
+		}, "xat-fcm-token").start();
+	}
+}
