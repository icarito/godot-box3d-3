+void RichTextLabel::select_all() {
+	if (!selection.enabled) {
+		return;
+	}
+
+	Item *first = nullptr;
+	Item *last = nullptr;
+	int last_char = 0;
+	for (Item *item = main; item; item = _get_next_item(item, true)) {
+		int end_char = 0;
+		if (item->type == ITEM_TEXT) {
+			const int length = static_cast<ItemText *>(item)->text.length();
+			if (length == 0) {
+				continue;
+			}
+			end_char = length - 1;
+		} else if (item->type == ITEM_IMAGE) {
+			if (static_cast<ItemImage *>(item)->source_text.empty()) {
+				continue;
+			}
+		} else if (item->type != ITEM_NEWLINE) {
+			continue;
+		}
+		if (!first) {
+			first = item;
+		}
+		last = item;
+		last_char = end_char;
+	}
+
+	selection.from = first;
+	selection.from_char = 0;
+	selection.to = last;
+	selection.to_char = last_char;
+	selection.active = first != nullptr;
+	update();
+}
