@@ -195,6 +195,30 @@ public:
 		method_map[p_name] = md;
 	}
 
+	// Los JNISingleton guardan sus métodos en method_map (no en ClassDB), así que
+	// sin estos overrides has_method()/get_method_list() no los ven y GDScript no
+	// puede detectarlos (sólo llamarlos por call()).
+	virtual bool has_method(const StringName &p_method) const {
+		if (method_map.has(p_method)) {
+			return true;
+		}
+		return Object::has_method(p_method);
+	}
+
+	virtual void get_method_list(List<MethodInfo> *p_list) const {
+		Object::get_method_list(p_list);
+		for (const Map<StringName, MethodData>::Element *E = method_map.front(); E; E = E->next()) {
+			MethodInfo mi;
+			mi.name = E->key();
+			Vector<Variant::Type> argtypes = E->get().argtypes;
+			for (int i = 0; i < argtypes.size(); i++) {
+				mi.arguments.push_back(PropertyInfo(argtypes[i], "arg" + itos(i + 1)));
+			}
+			mi.return_val = PropertyInfo(E->get().ret_type, "");
+			p_list->push_back(mi);
+		}
+	}
+
 	void add_signal(const StringName &p_name, const Vector<Variant::Type> &p_args) {
 		if (p_args.size() == 0)
 			ADD_SIGNAL(MethodInfo(p_name));
