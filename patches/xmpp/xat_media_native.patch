+/**************************************************************************/
+/*  xat_media_ios.h                                                       */
+/*                                                                        */
+/*  Contraparte iOS del plugin nativo XatMedia (ver XatMedia.java en      */
+/*  Android): selector nativo de documentos/fotos y cámara del sistema.   */
+/*  Se registra como singleton Godot "XatMedia" con la MISMA interfaz    */
+/*  GDScript que la versión Android, para que app/ sea multiplataforma.  */
+/**************************************************************************/
+
+#ifndef XAT_MEDIA_IOS_H
+#define XAT_MEDIA_IOS_H
+
+#include "core/object.h"
+#include "core/ustring.h"
+
+class XatMediaIOS : public Object {
+	GDCLASS(XatMediaIOS, Object);
+
+	static void _bind_methods();
+
+private:
+	bool pending = false;
+
+public:
+	bool is_available();
+	bool is_busy();
+	bool has_camera();
+	void pick_image();
+	void pick_file();
+	void take_photo();
+
+	// Invocados por el delegate Objective-C (mismo hilo principal).
+	void emit_media_picked(const String &p_path);
+	void emit_media_cancelled();
+	void emit_media_error(const String &p_reason);
+
+	XatMediaIOS();
+	~XatMediaIOS();
+};
+
+#endif // XAT_MEDIA_IOS_H
diff --git a/platform/iphone/xat_media_ios.mm b/platform/iphone/xat_media_ios.mm
new file mode 100644
index 0000000000..2440c0dcb3
--- /dev/null
+++ b/platform/iphone/xat_media_ios.mm
@@ -0,0 +1,214 @@
+/**************************************************************************/
+/*  xat_media_ios.mm                                                      */
+/*                                                                        */
+/*  Implementación iOS del singleton XatMedia: UIImagePickerController    */
+/*  para cámara y fototeca, UIDocumentPickerViewController para archivos. */
+/*  Los resultados se copian al sandbox (Documents/media) y se devuelven  */
+/*  como rutas absolutas legibles por Godot.                              */
+/**************************************************************************/
+
+#include "xat_media_ios.h"
+
+#include "core/class_db.h"
+#include "core/method_bind.h"
+
+#import "app_delegate.h"
+#import "view_controller.h"
+
+#import <MobileCoreServices/MobileCoreServices.h>
+#import <UIKit/UIKit.h>
+
+// Directorio de trabajo: Documents/media del propio sandbox. Godot puede leer
+// rutas absolutas dentro del sandbox de la app.
+static NSString *xat_media_directory() {
+	NSArray *paths = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES);
+	NSString *base = paths.count > 0 ? paths[0] : NSTemporaryDirectory();
+	NSString *dir = [base stringByAppendingPathComponent:@"media"];
+	[[NSFileManager defaultManager] createDirectoryAtPath:dir
+							  withIntermediateDirectories:YES
+											   attributes:nil
+													error:nil];
+	return dir;
+}
+
+static NSString *xat_media_timestamp() {
+	long long ms = (long long)([[NSDate date] timeIntervalSince1970] * 1000.0);
+	return [NSString stringWithFormat:@"%lld", ms];
+}
+
+@interface XatMediaIOSDelegate : NSObject <UIImagePickerControllerDelegate, UINavigationControllerDelegate, UIDocumentPickerDelegate>
+@property(nonatomic, assign) XatMediaIOS *owner;
+@end
+
+@implementation XatMediaIOSDelegate
+
+- (void)imagePickerController:(UIImagePickerController *)picker didFinishPickingMediaWithInfo:(NSDictionary<UIImagePickerControllerInfoKey, id> *)info {
+	[picker dismissViewControllerAnimated:YES completion:nil];
+	XatMediaIOS *owner = self.owner;
+	if (owner == nullptr) {
+		return;
+	}
+	UIImage *image = info[UIImagePickerControllerOriginalImage];
+	if (image == nil) {
+		owner->emit_media_error("sin-imagen");
+		return;
+	}
+	NSData *data = UIImageJPEGRepresentation(image, 0.9);
+	if (data == nil) {
+		owner->emit_media_error("guardar");
+		return;
+	}
+	NSString *path = [xat_media_directory() stringByAppendingPathComponent:
+											 [NSString stringWithFormat:@"foto_%@.jpg", xat_media_timestamp()]];
+	if (![data writeToFile:path atomically:YES]) {
+		owner->emit_media_error("guardar");
+		return;
+	}
+	owner->emit_media_picked(String([path UTF8String]));
+}
+
+- (void)imagePickerControllerDidCancel:(UIImagePickerController *)picker {
+	[picker dismissViewControllerAnimated:YES completion:nil];
+	if (self.owner != nullptr) {
+		self.owner->emit_media_cancelled();
+	}
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {
+	XatMediaIOS *owner = self.owner;
+	if (owner == nullptr) {
+		return;
+	}
+	if (urls.count == 0) {
+		owner->emit_media_error("sin-archivo");
+		return;
+	}
+	NSURL *src = urls[0];
+	BOOL scoped = [src startAccessingSecurityScopedResource];
+	NSString *name = src.lastPathComponent != nil ? src.lastPathComponent : @"adjunto";
+	NSString *dest = [xat_media_directory() stringByAppendingPathComponent:
+													   [NSString stringWithFormat:@"%@_%@", xat_media_timestamp(), name]];
+	[[NSFileManager defaultManager] removeItemAtPath:dest error:nil];
+	NSError *error = nil;
+	BOOL ok = [[NSFileManager defaultManager] copyItemAtURL:src
+													 toURL:[NSURL fileURLWithPath:dest]
+													 error:&error];
+	if (scoped) {
+		[src stopAccessingSecurityScopedResource];
+	}
+	if (!ok || error != nil) {
+		owner->emit_media_error("copia-fallida");
+		return;
+	}
+	owner->emit_media_picked(String([dest UTF8String]));
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller {
+	if (self.owner != nullptr) {
+		self.owner->emit_media_cancelled();
+	}
+}
+
+@end
+
+// Delegate estático: la presentación es única y el controlador vive en el
+// stack de UIKit mientras está visible.
+static XatMediaIOSDelegate *xat_media_delegate() {
+	static XatMediaIOSDelegate *delegate = nil;
+	if (delegate == nil) {
+		delegate = [[XatMediaIOSDelegate alloc] init];
+	}
+	return delegate;
+}
+
+void XatMediaIOS::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("isAvailable"), &XatMediaIOS::is_available);
+	ClassDB::bind_method(D_METHOD("isBusy"), &XatMediaIOS::is_busy);
+	ClassDB::bind_method(D_METHOD("hasCamera"), &XatMediaIOS::has_camera);
+	ClassDB::bind_method(D_METHOD("pickImage"), &XatMediaIOS::pick_image);
+	ClassDB::bind_method(D_METHOD("pickFile"), &XatMediaIOS::pick_file);
+	ClassDB::bind_method(D_METHOD("takePhoto"), &XatMediaIOS::take_photo);
+
+	ADD_SIGNAL(MethodInfo("media_picked", PropertyInfo(Variant::STRING, "path")));
+	ADD_SIGNAL(MethodInfo("media_cancelled"));
+	ADD_SIGNAL(MethodInfo("media_error", PropertyInfo(Variant::STRING, "reason")));
+}
+
+bool XatMediaIOS::is_available() {
+	return true;
+}
+
+bool XatMediaIOS::is_busy() {
+	return pending;
+}
+
+bool XatMediaIOS::has_camera() {
+	return [UIImagePickerController isSourceTypeAvailable:UIImagePickerControllerSourceTypeCamera];
+}
+
+void XatMediaIOS::pick_image() {
+	if (pending) {
+		return;
+	}
+	if (![UIImagePickerController isSourceTypeAvailable:UIImagePickerControllerSourceTypePhotoLibrary]) {
+		emit_media_error("sin-selector");
+		return;
+	}
+	UIImagePickerController *picker = [[UIImagePickerController alloc] init];
+	picker.sourceType = UIImagePickerControllerSourceTypePhotoLibrary;
+	picker.mediaTypes = @[ (NSString *)kUTTypeImage ];
+	XatMediaIOSDelegate *delegate = xat_media_delegate();
+	delegate.owner = this;
+	picker.delegate = delegate;
+	pending = true;
+	[AppDelegate.viewController presentViewController:picker animated:YES completion:nil];
+}
+
+void XatMediaIOS::pick_file() {
+	if (pending) {
+		return;
+	}
+	UIDocumentPickerViewController *picker = [[UIDocumentPickerViewController alloc] initWithDocumentTypes:@[ @"public.item" ]
+																									inMode:UIDocumentPickerModeImport];
+	XatMediaIOSDelegate *delegate = xat_media_delegate();
+	delegate.owner = this;
+	picker.delegate = delegate;
+	pending = true;
+	[AppDelegate.viewController presentViewController:picker animated:YES completion:nil];
+}
+
+void XatMediaIOS::take_photo() {
+	if (pending) {
+		return;
+	}
+	if (![UIImagePickerController isSourceTypeAvailable:UIImagePickerControllerSourceTypeCamera]) {
+		emit_media_error("sin-camara");
+		return;
+	}
+	UIImagePickerController *picker = [[UIImagePickerController alloc] init];
+	picker.sourceType = UIImagePickerControllerSourceTypeCamera;
+	XatMediaIOSDelegate *delegate = xat_media_delegate();
+	delegate.owner = this;
+	picker.delegate = delegate;
+	pending = true;
+	[AppDelegate.viewController presentViewController:picker animated:YES completion:nil];
+}
+
