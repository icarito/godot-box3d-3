@@ -0,0 +1,374 @@
+/**************************************************************************/
+/*  XatMedia.java                                                         */
+/*                                                                        */
+/*  Plugin Android integrado del fork xat: selector nativo de documentos  */
+/*  (Storage Access Framework) y cámara del sistema. Godot 3 no expone   */
+/*  ninguna de las dos APIs, así que viven en la capa Java del motor y   */
+/*  se registran como singleton Godot ("XatMedia").                      */
+/**************************************************************************/
+
+package org.godotengine.godot;
+
+import android.app.Activity;
+import android.content.ContentResolver;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Build;
+import android.provider.MediaStore;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.core.content.FileProvider;
+
+import org.godotengine.godot.plugin.GodotPlugin;
+import org.godotengine.godot.plugin.SignalInfo;
+import org.godotengine.godot.plugin.UsedByGodot;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Selector nativo de archivos/cámara para xat.
+ *
+ * El resultado llega por señales en el hilo principal de Godot:
+ * <ul>
+ *   <li>{@code media_picked(path)}: ruta absoluta lista (dentro del
+ *       almacenamiento propio de la app, que Godot sí puede leer).</li>
+ *   <li>{@code media_cancelled()}: el usuario cerró el selector/cámara.</li>
+ *   <li>{@code media_error(reason)}: motivo del fallo ("sin-camara", ...).</li>
+ * </ul>
+ */
+public class XatMedia extends GodotPlugin {
+	public static final String PLUGIN_NAME = "XatMedia";
+
+	private static final String TAG = "XatMedia";
+
+	private static final int REQUEST_PICK = 0x58415401;
+	private static final int REQUEST_CAMERA = 0x58415402;
+
+	private boolean pending = false;
+	private File cameraFile;
+	// APK a instalar si el usuario todavía no habilitó "instalar apps desconocidas".
+	private String pendingApkPath = "";
+
+	public XatMedia(Godot godot) {
+		super(godot);
+	}
+
+	@NonNull
+	@Override
+	public String getPluginName() {
+		return PLUGIN_NAME;
+	}
+
+	@NonNull
+	@Override
+	public Set<SignalInfo> getPluginSignals() {
+		return new HashSet<>(Arrays.asList(
+				new SignalInfo("media_picked", String.class),
+				new SignalInfo("media_cancelled"),
+				new SignalInfo("media_error", String.class)));
+	}
+
+	@UsedByGodot
+	public boolean isAvailable() {
+		return true;
+	}
+
+	@UsedByGodot
+	public boolean isBusy() {
+		return pending;
+	}
+
+	@UsedByGodot
+	public boolean hasCamera() {
+		Activity activity = getActivity();
+		if (activity == null) {
+			return false;
+		}
+		Intent intent = new Intent(MediaStore.ACTION_IMAGE_CAPTURE);
+		return intent.resolveActivity(activity.getPackageManager()) != null;
+	}
+
+	/** Abre el selector nativo limitado a imágenes. */
+	@UsedByGodot
+	public void pickImage() {
+		launchPicker("image/*");
+	}
+
+	/** Abre el selector nativo para cualquier tipo de archivo. */
+	@UsedByGodot
+	public void pickFile() {
+		launchPicker("*/*");
+	}
+
+	/** Abre la app de cámara y guarda la foto en el almacenamiento de la app. */
+	@UsedByGodot
+	public void takePhoto() {
+		final Activity activity = getActivity();
+		if (activity == null || pending) {
+			return;
+		}
+		Intent intent = new Intent(MediaStore.ACTION_IMAGE_CAPTURE);
+		if (intent.resolveActivity(activity.getPackageManager()) == null) {
+			emitSignal("media_error", "sin-camara");
+			return;
+		}
+		try {
+			File dir = mediaDir(activity);
+			if (dir == null) {
+				emitSignal("media_error", "sin-espacio");
+				return;
+			}
+			cameraFile = new File(dir, "foto_" + System.currentTimeMillis() + ".jpg");
+			Uri output = FileProvider.getUriForFile(activity,
+					activity.getPackageName() + ".fileprovider", cameraFile);
+			intent.putExtra(MediaStore.EXTRA_OUTPUT, output);
+			intent.addFlags(Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+			pending = true;
+			activity.startActivityForResult(intent, REQUEST_CAMERA);
+		} catch (Exception e) {
+			Log.w(TAG, "No se pudo abrir la cámara", e);
+			pending = false;
+			emitSignal("media_error", "camara-fallida");
+		}
+	}
+
+	private void launchPicker(String mime) {
+		final Activity activity = getActivity();
+		if (activity == null || pending) {
+			return;
+		}
+		Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+		intent.addCategory(Intent.CATEGORY_OPENABLE);
+		intent.setType(mime);
+		intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+		try {
+			pending = true;
+			activity.startActivityForResult(intent, REQUEST_PICK);
+		} catch (Exception e) {
+			Log.w(TAG, "No se pudo abrir el selector de archivos", e);
+			pending = false;
+			emitSignal("media_error", "sin-selector");
+		}
+	}
+
+	// --- Actualizaciones (instalador de APK) ---
+
+	@UsedByGodot
+	public boolean can_install_packages() {
+		Activity activity = getActivity();
+		return activity == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.O
+				|| activity.getPackageManager().canRequestPackageInstalls();
+	}
+
+	/**
+	 * Abre el instalador del sistema para un APK ya descargado (ruta absoluta).
+	 * Si falta el permiso de "instalar apps desconocidas", abre los ajustes y
+	 * reintenta en {@link #onMainResume()}.
+	 */
+	@UsedByGodot
+	public boolean install_apk(String absolutePath) {
+		if (absolutePath == null || absolutePath.isEmpty()) {
+			return false;
+		}
+		pendingApkPath = absolutePath;
+		final Activity activity = getActivity();
+		if (activity == null) {
+			return false;
+		}
+		if (!can_install_packages()) {
+			try {
+				Intent settings = new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
+						Uri.parse("package:" + activity.getPackageName()));
+				activity.startActivity(settings);
+				return true;
+			} catch (RuntimeException e) {
+				Log.w(TAG, "No se pudo abrir los ajustes de instalación", e);
+				return false;
+			}
+		}
+		return launchApkInstaller();
+	}
+
+	private boolean launchApkInstaller() {
+		final Activity activity = getActivity();
+		if (activity == null || pendingApkPath.isEmpty()) {
+			return false;
+		}
+		File src = new File(pendingApkPath);
+		if (!src.isFile()) {
+			Log.w(TAG, "APK inexistente: " + pendingApkPath);
+			return false;
+		}
+		try {
+			// El FileProvider sólo expone external-files; copiamos ahí y servimos.
+			File dir = new File(activity.getExternalFilesDir(null), "updates");
+			if (!dir.exists() && !dir.mkdirs()) {
+				return false;
+			}
+			File dst = new File(dir, "xat-update.apk");
+			copyFile(src, dst);
+			Uri uri = FileProvider.getUriForFile(activity,
+					activity.getPackageName() + ".fileprovider", dst);
+			Intent intent = new Intent(Intent.ACTION_VIEW);
+			intent.setDataAndType(uri, "application/vnd.android.package-archive");
+			intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_ACTIVITY_NEW_TASK);
+			activity.startActivity(intent);
+			pendingApkPath = "";
+			return true;
+		} catch (Exception e) {
+			Log.w(TAG, "No se pudo instalar el APK", e);
+			return false;
+		}
+	}
+
+	private void copyFile(File src, File dst) throws Exception {
+		InputStream in = new java.io.FileInputStream(src);
+		OutputStream os = new FileOutputStream(dst);
+		try {
+			byte[] buffer = new byte[65536];
+			int read;
+			while ((read = in.read(buffer)) > 0) {
+				os.write(buffer, 0, read);
+			}
+		} finally {
+			try {
+				in.close();
+			} catch (Exception ignored) {
+			}
+			try {
+				os.close();
+			} catch (Exception ignored) {
+			}
+		}
+	}
+
+	@Override
+	public void onMainResume() {
+		if (!pendingApkPath.isEmpty() && can_install_packages()) {
+			launchApkInstaller();
+		}
+	}
+
+	@Override
+	public void onMainActivityResult(int requestCode, int resultCode, Intent data) {
+		if (requestCode != REQUEST_PICK && requestCode != REQUEST_CAMERA) {
+			return;
+		}
+		pending = false;
+		if (resultCode != Activity.RESULT_OK) {
+			emitSignal("media_cancelled");
+			return;
+		}
+		try {
+			if (requestCode == REQUEST_CAMERA) {
+				if (cameraFile != null && cameraFile.exists() && cameraFile.length() > 0) {
+					emitSignal("media_picked", cameraFile.getAbsolutePath());
+				} else {
+					emitSignal("media_error", "sin-imagen");
+				}
+			} else {
+				Uri uri = data != null ? data.getData() : null;
+				if (uri == null) {
+					emitSignal("media_error", "sin-archivo");
+					return;
+				}
+				String path = copyToAppStorage(uri);
+				if (path != null) {
+					emitSignal("media_picked", path);
+				} else {
+					emitSignal("media_error", "copia-fallida");
+				}
+			}
+		} catch (Exception e) {
+			Log.w(TAG, "Error procesando el resultado del selector", e);
+			emitSignal("media_error", "error");
+		}
+	}
+
+	private File mediaDir(Activity activity) {
+		File base = activity.getExternalFilesDir(null);
+		if (base == null) {
+			base = activity.getCacheDir();
+		}
+		if (base == null) {
+			return null;
+		}
+		File dir = new File(base, "media");
+		if (!dir.exists() && !dir.mkdirs()) {
+			return null;
+		}
+		return dir;
+	}
+
+	private String copyToAppStorage(Uri uri) throws Exception {
+		final Activity activity = getActivity();
+		if (activity == null) {
+			return null;
+		}
+		File dir = mediaDir(activity);
+		if (dir == null) {
+			return null;
+		}
+		ContentResolver resolver = activity.getContentResolver();
+		String mime = resolver.getType(uri);
+		File out = new File(dir, "adjunto_" + System.currentTimeMillis() + extensionFor(mime, uri));
+		InputStream in = resolver.openInputStream(uri);
+		if (in == null) {
+			return null;
+		}
+		OutputStream os = new FileOutputStream(out);
+		try {
+			byte[] buffer = new byte[16384];
+			int read;
+			while ((read = in.read(buffer)) > 0) {
+				os.write(buffer, 0, read);
+			}
+		} finally {
+			try {
+				in.close();
+			} catch (Exception ignored) {
+			}
+			try {
+				os.close();
+			} catch (Exception ignored) {
+			}
+		}
+		return out.length() > 0 ? out.getAbsolutePath() : null;
+	}
+
+	private String extensionFor(String mime, Uri uri) {
+		if (mime != null) {
+			if (mime.equals("image/png")) return ".png";
+			if (mime.equals("image/jpeg")) return ".jpg";
+			if (mime.equals("image/webp")) return ".webp";
+			if (mime.equals("image/gif")) return ".gif";
+			if (mime.equals("image/bmp")) return ".bmp";
+			if (mime.equals("image/heic") || mime.equals("image/heif")) return ".heic";
+			if (mime.startsWith("audio/ogg")) return ".ogg";
+			if (mime.equals("audio/mpeg")) return ".mp3";
+			if (mime.equals("audio/mp4") || mime.equals("audio/aac")) return ".m4a";
+			if (mime.equals("audio/wav")) return ".wav";
+			if (mime.equals("application/pdf")) return ".pdf";
+			if (mime.startsWith("text/")) return ".txt";
+		}
+		String last = uri.getLastPathSegment();
+		if (last != null) {
+			int dot = last.lastIndexOf('.');
+			if (dot >= 0 && dot < last.length() - 1) {
+				String ext = last.substring(dot);
+				if (ext.length() <= 6) {
+					return ext;
+				}
+			}
+		}
+		return ".bin";
+	}
+}
