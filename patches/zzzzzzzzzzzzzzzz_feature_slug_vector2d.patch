new file mode 100644
index 0000000000..9a2bdebf94
--- /dev/null
+++ b/modules/slug/doc_classes/SlugVector2D.xml
@@ -0,0 +1,31 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="SlugVector2D" inherits="Node2D" version="3.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
+	<brief_description>
+		Draws a [SlugVector] (an SVG) as flat 2D UI with the Slug algorithm.
+	</brief_description>
+	<description>
+		SlugVector2D draws the filled regions of a [SlugVector] in 2D directly from their Bézier outlines, so the image stays crisp at any scale. It is meant for flat UI (icons, HUD layers) where a rasterized texture would pixelate when scaled. Each region keeps the fill color authored in the SVG (or the [SlugVector] fill/stroke roles), multiplied by [member tint].
+		[member size] is the height in pixels of the vector's bounding box; the width follows the SVG's aspect ratio. If [member centered] is [code]true[/code] the node's origin is the center of the drawing, otherwise its top-left corner.
+		SlugVector2D only works with the GLES3 rendering backend; under GLES2 or with a null/invalid [member vector], nothing is drawn. Up to 255 regions are supported per vector.
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+	</methods>
+	<members>
+		<member name="centered" type="bool" setter="set_centered" getter="get_centered" default="true">
+			If [code]true[/code], the node's origin is the center of the drawing; otherwise it is the top-left corner.
+		</member>
+		<member name="size" type="float" setter="set_size" getter="get_size" default="64.0">
+			The height, in pixels, of the vector's bounding box. The width is derived from the SVG's aspect ratio.
+		</member>
+		<member name="tint" type="Color" setter="set_tint" getter="get_tint" default="Color( 1, 1, 1, 1 )">
+			The color multiplied onto every region's fill color, in addition to the inherited [member CanvasItem.modulate].
+		</member>
+		<member name="vector" type="SlugVector" setter="set_vector" getter="get_vector">
+			The [SlugVector] to draw.
+		</member>
+	</members>
+	<constants>
+	</constants>
+</class>
