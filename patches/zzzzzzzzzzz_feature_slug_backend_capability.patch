+	// siguen siendo validas para el layout. Se decide por capacidad real del
+	// backend, no por OS::get_current_video_driver().
+	if (slug_backend_supports_float_textures()) {
 		curve_tex.instance();
 		curve_tex->create_from_image(curve_img, 0);
 		band_tex.instance();
