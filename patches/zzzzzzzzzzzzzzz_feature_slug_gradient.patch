+		SlugGradientStop stop;
+		stop.offset = p_g->stops[i].offset;
+		stop.role = _slug_svg_role(p_g->stops[i].color);
+		if (stop.role == SLUG_PAINT_LITERAL) {
+			stop.color = _slug_svg_color(p_g->stops[i].color, 1.0f);
+		}
+		def.stops.push_back(stop);
+	}
