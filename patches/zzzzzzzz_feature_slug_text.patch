+/*************************************************************************/
+/*  slug_label_3d.h                                                     */
+/*************************************************************************/
+/* Godot 3.6 module: modules/slug                                       */
+/*************************************************************************/
+
+#ifndef SLUG_LABEL_3D_H
+#define SLUG_LABEL_3D_H
+
+#include "scene/3d/visual_instance.h"
