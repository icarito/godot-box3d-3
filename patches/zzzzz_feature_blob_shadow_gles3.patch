+int VisualServerBlobShadows::qsort_cmp_func(const void *a, const void *b) {
+	const SortFocusCaster *pa = (const SortFocusCaster *)a;
+	const SortFocusCaster *pb = (const SortFocusCaster *)b;
+
+	return (pa->distance > pb->distance);
+}
