+	if (storage->config.use_texture_array_environment) {
+		state.scene_shader.add_custom_define("#define RADIANCE_MAP_ARRAY_AVAILABLE\n");
+	}
+	if (bool(GLOBAL_GET("rendering/quality/gi_probes/enabled"))) {
