diff --git a/frt_godot.cc b/frt_godot.cc
index 72c2d9f..255ccb4 100644
--- a/frt_godot.cc
+++ b/frt_godot.cc
@@ -418,6 +418,19 @@ public: // EventHandler
 		mouse_button->set_pressed(pressed);
 		input_->parse_input_event(mouse_button);
 	}
+	// Swipe continuo de touchpad (3+ dedos, sólo Wayland) como InputEventPanGesture:
+	// device = 1000+dedos en begin/update (delta (0,0) en begin, px de superficie en
+	// update); 2000+dedos en end; 3000+dedos en end cancelado. position = último mouse.
+	void handle_swipe_event(int phase, int fingers, float dx, float dy, bool cancelled) override {
+		Ref<InputEventPanGesture> pan;
+		pan.instance();
+		fill_modifier_state(pan);
+		Point2i posi(mouse_pos_.x, mouse_pos_.y);
+		pan->set_position(posi);
+		pan->set_device((phase == 2 ? (cancelled ? 3000 : 2000) : 1000) + fingers);
+		pan->set_delta(phase == 1 ? Vector2(dx, dy) : Vector2());
+		input_->parse_input_event(pan);
+	}
 	void handle_js_status_event(int id, bool connected, const char *name, const char *guid) override {
 		input_->joy_connection_changed(id, connected, name, guid);
 	}
diff --git a/frt_wl_gestures.cc b/frt_wl_gestures.cc
new file mode 100644
index 0000000..af68d81
--- /dev/null
+++ b/frt_wl_gestures.cc
@@ -0,0 +1,110 @@
+
+#include <SDL.h>
+#include "frt_wl_gestures.h"
+
+#ifdef FRT_WL_GESTURES
+#include <SDL_syswm.h>
+#include <string.h>
+#include <wayland-client.h>
+#include "pointer-gestures-v1.h"
+
+struct FrtWlGestures::Impl {
+	typedef FrtWlGestures::Callback Callback;
+	Callback cb = 0;
+	void *ud = 0;
+	wl_display *display = 0;
+	wl_event_queue *queue = 0;
+	wl_registry *registry = 0;
+	wl_seat *seat = 0;
+	wl_pointer *pointer = 0;
+	zwp_pointer_gestures_v1 *gestures = 0;
+	zwp_pointer_gesture_swipe_v1 *swipe = 0;
+	uint32_t seat_caps = 0;
+	int fingers = 0;
+
+	static void on_global(void *d, wl_registry *r, uint32_t name, const char *iface, uint32_t ver) {
+		Impl *g = (Impl *)d;
+		if (!strcmp(iface, "wl_seat") && !g->seat) {
+			g->seat = (wl_seat *)wl_registry_bind(r, name, &wl_seat_interface, ver < 5 ? ver : 5);
+			static const wl_seat_listener sl = { on_caps, on_name };
+			wl_seat_add_listener(g->seat, &sl, g);
+		} else if (!strcmp(iface, "zwp_pointer_gestures_v1") && !g->gestures) {
+			g->gestures = (zwp_pointer_gestures_v1 *)wl_registry_bind(r, name, &zwp_pointer_gestures_v1_interface, 1);
+		}
+	}
+	static void on_global_remove(void *, wl_registry *, uint32_t) {}
+	static void on_caps(void *d, wl_seat *, uint32_t caps) { ((Impl *)d)->seat_caps = caps; }
+	static void on_name(void *, wl_seat *, const char *) {}
+	static void on_begin(void *d, zwp_pointer_gesture_swipe_v1 *, uint32_t, uint32_t, wl_surface *, uint32_t fingers) {
+		Impl *g = (Impl *)d;
+		g->fingers = fingers;
+		if (g->fingers >= 3 && g->cb)
+			g->cb(g->ud, 0, g->fingers, 0, 0, false);
+	}
+	static void on_update(void *d, zwp_pointer_gesture_swipe_v1 *, uint32_t, wl_fixed_t dx, wl_fixed_t dy) {
+		Impl *g = (Impl *)d;
+		if (g->fingers >= 3 && g->cb)
+			g->cb(g->ud, 1, g->fingers, (float)wl_fixed_to_double(dx), (float)wl_fixed_to_double(dy), false);
+	}
+	static void on_end(void *d, zwp_pointer_gesture_swipe_v1 *, uint32_t, uint32_t, int32_t cancelled) {
+		Impl *g = (Impl *)d;
+		if (g->fingers >= 3 && g->cb)
+			g->cb(g->ud, 2, g->fingers, 0, 0, cancelled != 0);
+		g->fingers = 0;
+	}
+
+	void init(SDL_Window *window, Callback c, void *userdata) {
+		const char *drv = SDL_GetCurrentVideoDriver();
+		if (!drv || strcmp(drv, "wayland"))
+			return;
+		SDL_SysWMinfo info;
+		SDL_VERSION(&info.version);
+		if (!SDL_GetWindowWMInfo(window, &info) || info.subsystem != SDL_SYSWM_WAYLAND)
+			return;
+		cb = c;
+		ud = userdata;
+		display = info.info.wl.display;
+		queue = wl_display_create_queue(display);
+		wl_display *wrapper = (wl_display *)wl_proxy_create_wrapper(display);
+		wl_proxy_set_queue((wl_proxy *)wrapper, queue);
+		registry = wl_display_get_registry(wrapper);
+		wl_proxy_wrapper_destroy(wrapper);
+		static const wl_registry_listener rl = { on_global, on_global_remove };
+		wl_registry_add_listener(registry, &rl, this);
+		wl_display_roundtrip_queue(display, queue); // globales
+		wl_display_roundtrip_queue(display, queue); // capabilities del seat
+		if (!seat || !gestures || !(seat_caps & WL_SEAT_CAPABILITY_POINTER))
+			return; // sin gestos: queda no-op
+		pointer = wl_seat_get_pointer(seat);
+		swipe = zwp_pointer_gestures_v1_get_swipe_gesture(gestures, pointer);
+		static const zwp_pointer_gesture_swipe_v1_listener sw = { on_begin, on_update, on_end };
+		zwp_pointer_gesture_swipe_v1_add_listener(swipe, &sw, this);
+		wl_display_flush(display);
+	}
+	// Sin bloquear: lee del socket lo que SDL ya haya traído y despacha nuestra cola.
+	void dispatch() {
+		if (!swipe)
+			return;
+		while (wl_display_prepare_read_queue(display, queue) != 0)
+			wl_display_dispatch_queue_pending(display, queue);
+		wl_display_flush(display);
+		wl_display_read_events(display);
+		wl_display_dispatch_queue_pending(display, queue);
+	}
+};
+
+FrtWlGestures::~FrtWlGestures() { delete impl_; }
+void FrtWlGestures::init(SDL_Window *window, Callback c, void *userdata) {
+	impl_ = new Impl;
+	impl_->init(window, c, userdata);
+}
+void FrtWlGestures::dispatch() {
+	if (impl_)
+		impl_->dispatch();
+}
+
+#else
+FrtWlGestures::~FrtWlGestures() {}
+void FrtWlGestures::init(SDL_Window *, Callback, void *) {}
+void FrtWlGestures::dispatch() {}
+#endif
diff --git a/frt_wl_gestures.h b/frt_wl_gestures.h
new file mode 100644
index 0000000..da5376b
--- /dev/null
+++ b/frt_wl_gestures.h
@@ -0,0 +1,21 @@
+// frt_wl_gestures.h
+/*
+  Swipes de touchpad (zwp_pointer_gestures_v1) para FRT sobre Wayland.
+  SDL no los expone: se abre un wl_pointer propio sobre el wl_display de SDL y se
+  engancha el swipe. Usa una cola privada (los eventos de SDL no se tocan) que se
+  despacha sin bloquear desde el hilo principal. La implementación vive en
+  frt_wl_gestures.cc (SDL_syswm.h arrastra X11 y rompe los nombres de Godot).
+  Fuera de Wayland (x11/kmsdrm) o sin libwayland-client es no-op.
+ */
+
+struct SDL_Window;
+
+struct FrtWlGestures {
+	// Fase 0=begin 1=update 2=end; dx/dy en px de superficie; cancelled sólo en end.
+	typedef void (*Callback)(void *ud, int phase, int fingers, float dx, float dy, bool cancelled);
+	struct Impl;
+	Impl *impl_ = 0;
+	~FrtWlGestures();
+	void init(SDL_Window *window, Callback c, void *userdata);
+	void dispatch();
+};
