 def get_flags():
@@ -69,6 +70,11 @@ def configure_misc(env):
 	env.Append(CPPPATH=['#platform/frt'])
 	env.Append(CPPFLAGS=['-DUNIX_ENABLED', '-DGLES_ENABLED', '-DJOYDEV_ENABLED'])
 	env.Append(CPPFLAGS=['-DFRT_ENABLED'])
+	if env['frt_desktop_gl']:
+		# Tells is_viable() to enforce the desktop version floors (GL 3.3 for
+		# the GLES3 driver) instead of the ES ones. GLES_OVER_GL and GLAD_ENABLED
+		# come from drivers/gl_context/SCsub, which reads this same option.
+		env.Append(CPPFLAGS=['-DOPENGL_ENABLED'])
 	env.Append(LIBS=['pthread', 'z', 'dl'])
 	if env['use_static_cpp']:
 		env.Append(LINKFLAGS=['-static-libgcc', '-static-libstdc++'])
