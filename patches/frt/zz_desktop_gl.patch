--- a/sdl2_adapter.h
+++ b/sdl2_adapter.h
@@ -459,6 +459,31 @@
 	void swap_buffers_gl() {
 		SDL_GL_SwapWindow(window_);
 	}
+	void set_clipboard_text(const char *text) {
+		SDL_SetClipboardText(text);
+	}
+	char *get_clipboard_text() const {
+		return SDL_GetClipboardText();
+	}
+	void free_clipboard_text(char *text) const {
+		if (text)
+			SDL_free(text);
+	}
+	bool has_clipboard_text() const {
+		return SDL_HasClipboardText() == SDL_TRUE;
+	}
+	void set_ime_active(bool active) {
+		// Parity with what x11 does (XSetICFocus/XUnsetICFocus): the text
+		// committed by the IME already arrives through SDL_TEXTINPUT.
+		if (active)
+			SDL_StartTextInput();
+		else
+			SDL_StopTextInput();
+	}
+	void set_ime_position(int x, int y) {
+		SDL_Rect rect = { x, y, 1, 1 };
+		SDL_SetTextInputRect(&rect);
+	}
 	void set_use_vsync_gl(bool enable) {
 		SDL_GL_SetSwapInterval(enable ? 1 : 0);
 	}
