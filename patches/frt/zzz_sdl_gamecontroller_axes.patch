+			if ((id = get_gc_id(ev.caxis.which)) < 0)
+				return;
+			int axis = ev.caxis.axis;
+			float value = (float)ev.caxis.value / 32768.0f;
+			handler_->handle_js_axis_event(id, axis, value);
