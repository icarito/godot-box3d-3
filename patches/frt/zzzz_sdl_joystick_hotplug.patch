+	// SDL 2.30+ only notices joysticks connected after startup through udev, and
+	// where SDL is built without libudev (this distro, many CFWs) there is no
+	// hotplug at all: SDL never queues SDL_JOYDEVICEADDED for the new pad. Rather
+	// than fall back to the classic driver -- which reads the js* nodes and
+	// builds the device GUIDs from the name, changing them and breaking the
+	// GameControllerDB mappings -- watch /dev/input and force SDL to enumerate
+	// again. SDL_InitSubSystem re-queues SDL_JOYDEVICEADDED for the pads present,
+	// with the same driver and GUIDs as at startup.
+	void reenumerate_joysticks() {
+		// SDL is about to close its joystick handles: notify Godot the pads are
+		// gone and drop ours. The add events queued below re-notify the ones
+		// still present (the caller pumps SDL right after this).
+		for (int id = 0; id < MAX_JOYSTICKS; id++) {
+			if (js_[id]) {
+				handler_->handle_js_status_event(id, false, "", "");
+				js_[id] = 0;
+				gc_[id] = 0;
+			}
+		}
+		rumble_supported_ = 0;
+		SDL_QuitSubSystem(SDL_INIT_GAMECONTROLLER);
+		SDL_QuitSubSystem(SDL_INIT_JOYSTICK);
+		SDL_InitSubSystem(SDL_INIT_JOYSTICK);
+		SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER);
+		// Re-arm joystick events: after a quit/init cycle SDL can leave them
+		// disabled, which would detect the pads but drop every axis/button.
+		SDL_JoystickEventState(SDL_ENABLE);
+	}
+	// Open a udev monitor for the input subsystem. udev is dlopen'd so the
+	// build does not depend on libudev being in the cross sysroot; if it is not
+	// there at runtime the monitor simply never fires.
+	void init_udev_monitor() {
+		udev_lib_ = dlopen("libudev.so.1", RTLD_LAZY | RTLD_LOCAL);
+		if (!udev_lib_)
+			udev_lib_ = dlopen("libudev.so.0", RTLD_LAZY | RTLD_LOCAL);
+		if (!udev_lib_)
+			return;
+		udev_new_fn = (void *(*)())dlsym(udev_lib_, "udev_new");
+		udev_monitor_new_from_netlink_fn = (void *(*)(void *, const char *))dlsym(udev_lib_, "udev_monitor_new_from_netlink");
+		udev_monitor_filter_add_match_subsystem_devtype_fn = (int (*)(void *, const char *, const char *))dlsym(udev_lib_, "udev_monitor_filter_add_match_subsystem_devtype");
+		udev_monitor_enable_receiving_fn = (int (*)(void *))dlsym(udev_lib_, "udev_monitor_enable_receiving");
+		udev_monitor_get_fd_fn = (int (*)(void *))dlsym(udev_lib_, "udev_monitor_get_fd");
+		udev_monitor_receive_device_fn = (void *(*)(void *))dlsym(udev_lib_, "udev_monitor_receive_device");
+		udev_device_unref_fn = (void *(*)(void *))dlsym(udev_lib_, "udev_device_unref");
+		if (!udev_new_fn || !udev_monitor_new_from_netlink_fn || !udev_monitor_enable_receiving_fn || !udev_monitor_get_fd_fn || !udev_monitor_receive_device_fn)
+			return;
+		udev_ = udev_new_fn();
+		if (!udev_)
+			return;
+		udev_mon_ = udev_monitor_new_from_netlink_fn(udev_, "udev");
+		if (!udev_mon_)
+			return;
+		if (udev_monitor_filter_add_match_subsystem_devtype_fn)
+			udev_monitor_filter_add_match_subsystem_devtype_fn(udev_mon_,
+					"input", NULL);
+		udev_monitor_enable_receiving_fn(udev_mon_);
+		udev_mon_fd_ = udev_monitor_get_fd_fn(udev_mon_);
+	}
+	void poll_input_changes() {
+		if (!udev_mon_ || udev_mon_fd_ < 0)
+			return;
+		// Drain every pending udev event; one device appearing can produce
+		// several (event*, js*, by-id links), and a single re-enumeration
+		// already picks up all of them.
+		fd_set fds;
+		FD_ZERO(&fds);
+		FD_SET(udev_mon_fd_, &fds);
+		struct timeval tv;
+		tv.tv_sec = 0;
+		tv.tv_usec = 0;
+		if (select(udev_mon_fd_ + 1, &fds, NULL, NULL, &tv) <= 0)
+			return;
+		bool changed = false;
+		for (;;) {
+			void *dev = udev_monitor_receive_device_fn(udev_mon_);
+			if (!dev)
+				break;
+			changed = true;
+			if (udev_device_unref_fn)
+				udev_device_unref_fn(dev);
+		}
+		if (changed)
+			reenumerate_joysticks();
+	}
