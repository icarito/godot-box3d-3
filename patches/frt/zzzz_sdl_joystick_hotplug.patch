diff --git a/sdl2_adapter.h b/sdl2_adapter.h
index 8af4935..85a62ed 100644
--- a/sdl2_adapter.h
+++ b/sdl2_adapter.h
@@ -464,6 +464,12 @@ public:
 	}
 	void init_window(GraphicsAPI api, int width, int height, bool resizable, bool borderless, bool always_on_top, bool hidden) {
 		setenv("SDL_VIDEO_RPI_OPTIONS", "gravity=center,scale=letterbox,background=1", 0);
+		// SDL 2.30+ defaults to a udev-based Linux joystick backend. When SDL is
+		// built without libudev (many distros and CFWs), that backend never sees
+		// a pad connected after startup: no SDL_JOYDEVICEADDED, so no hotplug.
+		// The classic driver watches /dev/input (inotify/polling) and does
+		// hotplug; keep it overridable from the environment.
+		setenv("SDL_JOYSTICK_LINUX_CLASSIC", "1", 0);
 		if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO | SDL_INIT_JOYSTICK | SDL_INIT_GAMECONTROLLER) < 0)
 			fatal("SDL_Init failed: %s.", SDL_GetError());
 		int flags = (hidden ? SDL_WINDOW_HIDDEN : SDL_WINDOW_SHOWN) | SDL_WINDOW_ALLOW_HIGHDPI | SDL_WINDOW_OPENGL;
