+	// SDL 2.30+ only notices joysticks connected after startup through udev, and
+	// where SDL is built without libudev (this distro, many CFWs) there is no
+	// hotplug at all: SDL never queues SDL_JOYDEVICEADDED for the new pad. Rather
+	// than fall back to the classic driver -- which reads the js* nodes and
+	// builds the device GUIDs from the name, changing them and breaking the
+	// GameControllerDB mappings -- watch /dev/input and force SDL to enumerate
+	// again. SDL_InitSubSystem re-queues SDL_JOYDEVICEADDED for the pads present,
+	// with the same driver and GUIDs as at startup.
+	void reenumerate_joysticks() {
+		// SDL is about to close its joystick handles: notify Godot the pads are
+		// gone and drop ours. The add events queued below re-notify the ones
+		// still present (the caller pumps SDL right after this).
+		for (int id = 0; id < MAX_JOYSTICKS; id++) {
+			if (js_[id]) {
+				handler_->handle_js_status_event(id, false, "", "");
+				js_[id] = 0;
+				gc_[id] = 0;
+			}
+		}
+		rumble_supported_ = 0;
+		SDL_QuitSubSystem(SDL_INIT_GAMECONTROLLER);
+		SDL_QuitSubSystem(SDL_INIT_JOYSTICK);
+		SDL_InitSubSystem(SDL_INIT_JOYSTICK);
+		SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER);
+	}
+	void poll_input_changes() {
+		if (inotify_fd_ < 0)
+			return;
+		bool changed = false;
+		char buf[4096] __attribute__((aligned(__alignof__(struct inotify_event))));
+		for (;;) {
+			// Drain the whole batch so one device appearing does not re-init
+			// once per node (js* and event*).
+			ssize_t len = read(inotify_fd_, buf, sizeof(buf));
+			if (len <= 0)
+				break;
+			changed = true;
+		}
+		if (changed)
+			reenumerate_joysticks();
+	}
