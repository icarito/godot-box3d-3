 	bool is_vsync_enabled_gl() const {
 		return SDL_GL_GetSwapInterval() != 0;
 	}
+	// Serves whatever the windowing system has ready without dispatching any of
+	// it to the game. On Wayland, SDL's own pump answers the compositor's
+	// xdg_wm_base.ping from inside SDL_PumpEvents (the registered listener pongs
+	// there), while translated input and window events stay in SDL's queue for
+	// the next dispatch_events() call. Long blocking work (shader compilation)
+	// calls this so the compositor does not decide the process has hung.
+	void pump_events() {
+		SDL_PumpEvents();
+	}
 	void dispatch_events() {
 		SDL_Event ev;
