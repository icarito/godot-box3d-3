+		if (p_gained) {
+			if (main_loop_)
+				main_loop_->notification(MainLoop::NOTIFICATION_WM_FOCUS_IN);
+		} else {
+			input_->release_pressed_events();
+			if (main_loop_)
+				main_loop_->notification(MainLoop::NOTIFICATION_WM_FOCUS_OUT);
+		}
+	}
