 	void init_window(GraphicsAPI api, int width, int height, bool resizable, bool borderless, bool always_on_top, bool hidden) {
 		setenv("SDL_VIDEO_RPI_OPTIONS", "gravity=center,scale=letterbox,background=1", 0);
+		// X11 gets its decorations from the window manager. Under Wayland, SDL
+		// prefers libdecor's client-side decorations when the compositor does
+		// not advertise xdg-decoration -- GNOME does not -- but they are not
+		// drawn on our GL window and what the user gets is an undecorated
+		// window. Let the compositor decorate instead, the same as the x11
+		// build does. A user can still force libdecor back by exporting
+		// SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR=1.
+		setenv("SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR", "0", 0);
 		if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO | SDL_INIT_JOYSTICK) < 0)
 			fatal("SDL_Init failed: %s.", SDL_GetError());
 		int flags = (hidden ? SDL_WINDOW_HIDDEN : SDL_WINDOW_SHOWN) | SDL_WINDOW_ALLOW_HIGHDPI | SDL_WINDOW_OPENGL;
